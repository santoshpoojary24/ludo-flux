# Ludo Flux Server — Environment Variables
# Copy this to .env for local dev, or set in your Railway/Render project settings

# Server
PORT=3001
NODE_ENV=production

# JWT — change this to a long random string in production!
JWT_SECRET=change_me_to_a_long_random_secret_here

# Supabase Postgres connection string (Session Pooler recommended)
# Find this in: Supabase Dashboard → Settings → Database → Connection String → Node.js
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xesidtbftqwsaguncner:Santosh@2004#24@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Redis (Upstash or Railway Redis)
# REDIS_URL=redis://...

# CORS — set to your frontend domain(s) in production, comma-separated
# CLIENT_URL=https://your-app.vercel.app
