# Ludo Flux — Client Environment Variables
# Copy this to .env.local for local dev, or set these in your Vercel project settings

# URL of your deployed backend server (Express + Socket.io)
# For local development: http://localhost:3001
# For production: https://your-server.railway.app  (or Render, Fly.io, etc.)
VITE_API_URL=http://localhost:3001

# WebSocket server URL (usually same as API_URL)
VITE_SERVER_URL=http://localhost:3001
